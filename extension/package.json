{
  "name": "agent-mirror-vscode",
  "displayName": "Agent Mirror",
  "description": "Delivers phone-originated messages to Claude Code running in a VS Code terminal.",
  "version": "0.0.1",
  "publisher": "agent-mirror",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "agentMirror.start",
        "title": "Agent Mirror: Start Polling"
      },
      {
        "command": "agentMirror.stop",
        "title": "Agent Mirror: Stop Polling"
      },
      {
        "command": "agentMirror.testSendText",
        "title": "Agent Mirror: Send Test Text to Active Terminal"
      }
    ]
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.46.1"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.6.3"
  }
}
