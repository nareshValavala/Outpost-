# Agent Mirror daemon environment variables.
# Copy this file to .env.local and fill in real values. .env.local is gitignored.

# Supabase project URL, e.g. https://xxxxx.supabase.co
SUPABASE_URL=

# Supabase anon public key (safe for the daemon during phase 0/1;
# replaced with a user access token in phase 2).
SUPABASE_ANON_KEY=
