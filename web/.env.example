# Agent Mirror web app environment variables.
# Copy this file to .env.local and fill in real values. .env.local is gitignored.
# NEXT_PUBLIC_ prefix exposes these to the browser bundle — that's intended
# for SUPABASE_URL and ANON_KEY since they're designed to be public.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
